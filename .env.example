# Copy this file to .env.local and fill in values from:
# Firebase console → Project settings → General → Your apps → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL for the REST API / webhooks (Firebase Hosting rewrites route
# /api/** and /webhooks/** to Cloud Functions, so this is usually just
# your Hosting URL — leave blank to default to the current origin).
VITE_API_BASE_URL=
